<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressValidation>false</SuppressValidation>
    <SuppressIces>ICE91</SuppressIces>
    <DefineConstants>ProductVersion=$(ProductVersion);ReleaseId=$(ReleaseId);DesktopExe=$(DesktopExe);ProvisionerExe=$(ProvisionerExe);ReleaseManifest=$(ReleaseManifest)</DefineConstants>
  </PropertyGroup>
</Project>
