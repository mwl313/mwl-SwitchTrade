{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://switchtrade.local/contracts/c2-stage.v1.schema.json",
  "title": "SwitchTrade C2 stage result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "run_id", "attempt_id", "source_seat", "switch_role",
    "activation_generation", "advertisement_sha256", "last_passed_gate",
    "local_ready_gate", "proof_generation", "queued_local_frames", "stats", "failure"
  ],
  "properties": {
    "contract_version": { "const": "c2-stage.v1" },
    "run_id": { "type": "string", "format": "uuid" },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_seat": { "enum": ["member_a", "member_b"] },
    "switch_role": { "enum": ["a_room_joiner", "b_ap_host"] },
    "activation_generation": { "type": "integer", "minimum": 1 },
    "advertisement_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "last_passed_gate": { "enum": ["C_LOCAL_SIDE_READY", "C_BRIDGE_READY", "C_RFU_ACTIVE", null] },
    "local_ready_gate": { "enum": ["A_READY", "B_READY", null] },
    "proof_generation": { "type": "integer", "minimum": 0 },
    "queued_local_frames": { "type": "integer", "minimum": 0, "maximum": 256 },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queued_local_peak", "tx_rfu_frames", "rx_rfu_frames", "activation_count", "invalidations"],
      "properties": {
        "queued_local_peak": { "type": "integer", "minimum": 0, "maximum": 256 },
        "tx_rfu_frames": { "type": "integer", "minimum": 0 },
        "rx_rfu_frames": { "type": "integer", "minimum": 0 },
        "activation_count": { "type": "integer", "minimum": 0 },
        "invalidations": { "type": "integer", "minimum": 0 }
      }
    },
    "failure": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "gate", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 96 },
            "gate": { "type": "string", "minLength": 1, "maxLength": 96 },
            "message": { "type": "string", "maxLength": 500 }
          }
        }
      ]
    }
  }
}
