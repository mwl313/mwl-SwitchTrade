{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://switchtrade.local/contracts/p0-attestation.v2.schema.json",
  "title": "SwitchTrade P0 attestation for relay admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "run_id", "release", "run_generation", "stage_generation",
    "adapter_instance_sha256", "report_sha256"
  ],
  "properties": {
    "contract_version": { "const": "p0-attestation.v2" },
    "run_id": { "type": "string", "format": "uuid" },
    "release": { "type": "string", "minLength": 1, "maxLength": 64 },
    "run_generation": { "type": "integer", "minimum": 1 },
    "stage_generation": { "type": "integer", "minimum": 1 },
    "adapter_instance_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
