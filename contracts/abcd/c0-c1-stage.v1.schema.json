{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://switchtrade.local/contracts/c0-c1-stage.v1.schema.json",
  "title": "SwitchTrade C0/C1 stage result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "run_id", "attempt_id", "source_seat", "switch_role",
    "last_passed_gate", "advertisement_sha256", "failure"
  ],
  "properties": {
    "contract_version": { "const": "c0-c1-stage.v1" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_seat": { "enum": ["member_a", "member_b"] },
    "switch_role": { "enum": ["a_room_joiner", "b_ap_host"] },
    "last_passed_gate": {
      "enum": [
        "C0_AUTHENTICATED", "C0_PEER_READY", "C0_DATA_PLANE_PROVEN",
        "C1_ADVERTISEMENT_DELIVERED", null
      ]
    },
    "advertisement_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "failure": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "gate", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 96 },
            "gate": { "type": "string", "minLength": 1, "maxLength": 96 },
            "message": { "type": "string", "maxLength": 500 }
          }
        }
      ]
    }
  }
}
