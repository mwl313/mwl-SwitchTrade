<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SwitchTrade</AssemblyName>
    <RootNamespace>SwitchTrade.Desktop</RootNamespace>
    <Version>0.2.0-beta.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\..\assets\branding\SwitchTrade.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\**\*.ttf" />
    <EmbeddedResource Include="Assets\Fonts\**\OFL.txt" />
  </ItemGroup>
</Project>
