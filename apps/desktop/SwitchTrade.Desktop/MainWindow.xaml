<Window x:Class="SwitchTrade.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SwitchTrade" Width="1024" Height="720" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#13261F"
        FontFamily="Cascadia Mono, Consolas">
  <Grid Margin="34">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="24" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="LOCAL LINK UTILITY" Foreground="#9DE1C5" FontSize="13"
                   FontWeight="Bold" />
        <TextBlock Text="SwitchTrade" Foreground="#FFF9EC" FontFamily="Segoe UI Variable Display"
                   FontWeight="SemiBold" FontSize="38" Margin="0,2,0,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="#203C33" BorderBrush="#4CC397" BorderThickness="1"
              CornerRadius="18" Padding="16,9" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusLight" Width="10" Height="10" Fill="#D26459" Margin="0,0,9,0" />
          <TextBlock x:Name="StatusText" Text="BACKEND OFFLINE" Foreground="#FFF9EC"
                     FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#D9D5C8" BorderBrush="#081713" BorderThickness="7"
            CornerRadius="28" Padding="20">
      <Border Background="#5FC89F" BorderBrush="#2B745B" BorderThickness="4" CornerRadius="13"
              Padding="26">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock x:Name="ScreenTitle" Text="LINK DESK" Foreground="#FFF7D5"
                       FontSize="18" FontWeight="Bold" />
            <TextBlock Text="SWITCHTRADE" Foreground="#17312A" FontSize="13"
                       FontWeight="Bold" HorizontalAlignment="Right" />
          </Grid>
          <Border Grid.Row="1" Background="#F7F2E8" BorderBrush="#17312A" BorderThickness="3"
                  CornerRadius="6" Padding="26" Margin="0,18,0,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ContentControl x:Name="ScreenContent" />
            </ScrollViewer>
          </Border>
          <Grid Grid.Row="2">
            <TextBlock x:Name="HintText" Text="Choose how you want to connect."
                       Foreground="#17312A" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="TAB Move    ENTER Select    ESC Back" Foreground="#296C91"
                       FontSize="13" HorizontalAlignment="Right" />
          </Grid>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
