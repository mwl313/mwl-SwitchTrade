<Window x:Class="SwitchTrade.Desktop.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:SwitchTrade.Desktop.Controls"
        Title="SwitchTrade" Width="1240" Height="860" MinWidth="960" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}"
        FontFamily="{StaticResource BodyFontFamily}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
      <RowDefinition Height="40" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource CanvasDeepestBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid x:Name="HeaderContent" Margin="24,0" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="28" Height="28" Margin="0,0,10,0">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource ActionGreenBrush}"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,3,0,0" />
            <Ellipse Width="8" Height="8" Fill="{DynamicResource ActionGreenBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,3" />
            <Border Height="2" Width="22" Background="{DynamicResource ActionGreenBrush}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
            </Border>
          </Grid>
          <TextBlock Text="SwitchTrade" VerticalAlignment="Center"
                     FontFamily="{StaticResource HeadingFontFamily}" FontWeight="SemiBold"
                     FontSize="21" Foreground="{DynamicResource PrimaryTextBrush}" />
        </StackPanel>

        <ToggleButton x:Name="ReadinessButton" Grid.Column="1" VerticalAlignment="Center"
                      MinHeight="40" Padding="12,7" Background="{DynamicResource SurfaceLowBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      Foreground="{DynamicResource SecondaryTextBrush}"
                      automation:AutomationProperties.Name="Open local setup status">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsServiceReady}" Value="True">
                      <Setter Property="Fill" Value="{DynamicResource ActionGreenBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding ReadinessText}" VerticalAlignment="Center" FontSize="12" />
          </StackPanel>
        </ToggleButton>
        <Popup IsOpen="{Binding IsChecked, ElementName=ReadinessButton}"
               PlacementTarget="{Binding ElementName=ReadinessButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Background="{DynamicResource SurfaceHighestBrush}"
                  BorderBrush="{DynamicResource BorderStrongBrush}"
                  BorderThickness="1" CornerRadius="12" Padding="18" Width="312" Margin="0,8,0,0">
            <StackPanel>
              <TextBlock Text="System readiness" Style="{StaticResource SectionTitle}" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Text="Local control" />
                <TextBlock Grid.Column="1" Text="{Binding ControlStateText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Row="1" Text="Online relay" Margin="0,8,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RelayStateText}" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Row="2" Text="Switch radio" Margin="0,8,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RadioStateText}" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Row="3" Text="Trade session" Margin="0,8,0,0" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SessionStateText}" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
              </Grid>
            </StackPanel>
          </Border>
        </Popup>

        <Button Grid.Column="3" Command="{Binding SettingsCommand}" Style="{StaticResource TextButton}"
                automation:AutomationProperties.Name="Open settings">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource Icon.Settings}" Width="17" Height="17" Stretch="Uniform"
                  Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.6" Margin="0,0,7,0"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            <TextBlock Text="Settings" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceLowBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Button x:Name="BackButton" Command="{Binding BackCommand}" Style="{StaticResource TextButton}"
              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"
              Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibility}}"
              automation:AutomationProperties.Name="Go back">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource Icon.Back}" Width="16" Height="16" Stretch="Uniform"
                Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.8" Margin="0,0,7,0"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          <TextBlock Text="Back" />
        </StackPanel>
      </Button>
    </Border>

    <controls:ScenePresenter x:Name="ScenePresenter" Grid.Row="2" Content="{Binding CurrentScreen}"
                             MaxWidth="1080" Margin="24,12,24,16" HorizontalAlignment="Left"
                             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

    <Button x:Name="CreditsButton" Grid.Row="3" Content="Credits"
            Click="OpenCredits" Style="{StaticResource TextButton}"
            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,4"
            Padding="10,5" MinHeight="30" FontSize="12"
            automation:AutomationProperties.Name="Open credits" />

    <TextBlock Text="{Binding Announcement}" Width="1" Height="1" Opacity="0.01" IsHitTestVisible="False"
               automation:AutomationProperties.LiveSetting="Assertive"
               automation:AutomationProperties.Name="{Binding Announcement}" />
  </Grid>
</Window>
