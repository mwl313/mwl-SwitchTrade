<Window x:Class="SwitchTrade.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="SwitchTrade" Width="1120" Height="780" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="56,0,28,0" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="SwitchTrade" VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold"
                   FontSize="21" Foreground="{DynamicResource PrimaryTextBrush}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                    automation:AutomationProperties.Name="{Binding ReadinessText}"
                    automation:AutomationProperties.LiveSetting="Polite">
          <Ellipse Width="8" Height="8" Margin="0,0,8,0">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsServiceReady}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding ReadinessText}" VerticalAlignment="Center"
                     Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" />
        </StackPanel>

        <Button Grid.Column="3" Content="Settings" Command="{Binding SettingsCommand}"
                Style="{StaticResource TextButton}"
                automation:AutomationProperties.Name="Open settings" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Background="{DynamicResource CanvasBrush}">
      <Button Content="Back" Command="{Binding BackCommand}" Style="{StaticResource TextButton}"
              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="46,0,0,0"
              Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibility}}"
              automation:AutomationProperties.Name="Go back" />
    </Grid>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <ContentControl Content="{Binding CurrentScreen}" MaxWidth="1000"
                      Margin="56,8,32,40" HorizontalAlignment="Left"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
    </ScrollViewer>

    <TextBlock Text="{Binding Announcement}" Opacity="0" IsHitTestVisible="False"
               automation:AutomationProperties.LiveSetting="Assertive"
               automation:AutomationProperties.Name="{Binding Announcement}" />
  </Grid>
</Window>
