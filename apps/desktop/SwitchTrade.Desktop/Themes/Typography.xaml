<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="HeadingFontFamily">pack://application:,,,/SwitchTrade;component/Assets/Fonts/SpaceGrotesk/#Space Grotesk</FontFamily>
  <FontFamily x:Key="BodyFontFamily">pack://application:,,,/SwitchTrade;component/Assets/Fonts/Inter/#Inter</FontFamily>
  <FontFamily x:Key="MonoFontFamily">pack://application:,,,/SwitchTrade;component/Assets/Fonts/SpaceMono/#Space Mono</FontFamily>

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="ScreenTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFontFamily}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="LineHeight" Value="38" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style x:Key="HeroTitle" TargetType="TextBlock" BasedOn="{StaticResource ScreenTitle}">
    <Setter Property="FontSize" Value="38" />
    <Setter Property="LineHeight" Value="46" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFontFamily}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="RowTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFontFamily}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="SecondaryText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,7" />
  </Style>
  <Style x:Key="KickerText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource ActionGreenBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>
  <Style x:Key="CodeText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
</ResourceDictionary>
