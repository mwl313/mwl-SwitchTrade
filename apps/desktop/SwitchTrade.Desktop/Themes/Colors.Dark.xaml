  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}" />
  <SolidColorBrush x:Key="ActionGreenBrush" Color="{StaticResource ActionGreenColor}" />
  <SolidColorBrush x:Key="ActionGreenHoverBrush" Color="{StaticResource ActionGreenHoverColor}" />
  <SolidColorBrush x:Key="ActionGreenPressedBrush" Color="{StaticResource ActionGreenPressedColor}" />
  <SolidColorBrush x:Key="OnActionGreenBrush" Color="{StaticResource OnActionGreenColor}" />
