<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="CanvasDeepestColor">#0E0E0E</Color>
  <Color x:Key="CanvasColor">#131313</Color>
  <Color x:Key="SurfaceLowColor">#1C1B1B</Color>
  <Color x:Key="SurfaceColor">#201F1F</Color>
  <Color x:Key="SurfaceSubtleColor">#2A2A2A</Color>
  <Color x:Key="SurfaceHighestColor">#353534</Color>
