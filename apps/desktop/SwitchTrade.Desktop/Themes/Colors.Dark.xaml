  <Color x:Key="PrimaryTextColor">#E5E2E1</Color>
  <Color x:Key="SecondaryTextColor">#B9CCB2</Color>
  <Color x:Key="BorderColor">#3B4B37</Color>
  <Color x:Key="BorderStrongColor">#84967E</Color>
  <Color x:Key="ControlBorderColor">#84967E</Color>
  <Color x:Key="ActionGreenColor">#00E639</Color>
  <Color x:Key="ActionGreenHoverColor">#00FF41</Color>
  <Color x:Key="ActionGreenPressedColor">#72FF70</Color>
  <Color x:Key="OnActionGreenColor">#002203</Color>
  <Color x:Key="LinkBlueColor">#ADC6FF</Color>
  <Color x:Key="LinkBlueHoverColor">#D8E2FF</Color>
