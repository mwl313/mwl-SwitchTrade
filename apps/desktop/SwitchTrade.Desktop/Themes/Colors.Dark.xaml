  <Color x:Key="WarningTintColor">#3C2D08</Color>
  <Color x:Key="DangerColor">#FFB4AB</Color>
  <Color x:Key="DangerContainerColor">#93000A</Color>
  <Color x:Key="DangerTintColor">#3F1114</Color>
  <Color x:Key="DisabledSurfaceColor">#252525</Color>
  <Color x:Key="DisabledTextColor">#737972</Color>

  <SolidColorBrush x:Key="CanvasDeepestBrush" Color="{StaticResource CanvasDeepestColor}" />
  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="SurfaceLowBrush" Color="{StaticResource SurfaceLowColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource SurfaceSubtleColor}" />
  <SolidColorBrush x:Key="SurfaceHighestBrush" Color="{StaticResource SurfaceHighestColor}" />
  <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
