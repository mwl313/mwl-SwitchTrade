<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="CanvasColor">#F5F6F8</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="SurfaceSubtleColor">#F3F5F8</Color>
  <Color x:Key="SurfacePressedColor">#E8ECF2</Color>
  <Color x:Key="PrimaryTextColor">#181A20</Color>
  <Color x:Key="SecondaryTextColor">#5F6571</Color>
  <Color x:Key="BorderColor">#D9DDE5</Color>
  <Color x:Key="BorderStrongColor">#BFC6D2</Color>
  <Color x:Key="ControlBorderColor">#878F9E</Color>
  <Color x:Key="LinkBlueColor">#375BD2</Color>
  <Color x:Key="LinkBlueHoverColor">#2F50BC</Color>
  <Color x:Key="LinkBluePressedColor">#27449F</Color>
  <Color x:Key="BlueTintColor">#EAF0FF</Color>
  <Color x:Key="PartnerTealColor">#0F766E</Color>
  <Color x:Key="PartnerTealStrongColor">#0B625C</Color>
  <Color x:Key="TealTintColor">#E7F5F2</Color>
  <Color x:Key="SuccessColor">#21825B</Color>
  <Color x:Key="SuccessTintColor">#E9F6F0</Color>
  <Color x:Key="WarningColor">#A45F0B</Color>
  <Color x:Key="WarningTintColor">#FFF4DF</Color>
  <Color x:Key="DangerColor">#B42318</Color>
  <Color x:Key="DangerTintColor">#FFF0EE</Color>
  <Color x:Key="DisabledSurfaceColor">#EDF0F4</Color>
  <Color x:Key="DisabledTextColor">#818895</Color>

  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource SurfaceSubtleColor}" />
  <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}" />
  <SolidColorBrush x:Key="LinkBlueBrush" Color="{StaticResource LinkBlueColor}" />
  <SolidColorBrush x:Key="LinkBlueHoverBrush" Color="{StaticResource LinkBlueHoverColor}" />
  <SolidColorBrush x:Key="LinkBluePressedBrush" Color="{StaticResource LinkBluePressedColor}" />
  <SolidColorBrush x:Key="BlueTintBrush" Color="{StaticResource BlueTintColor}" />
  <SolidColorBrush x:Key="PartnerTealBrush" Color="{StaticResource PartnerTealColor}" />
  <SolidColorBrush x:Key="PartnerTealStrongBrush" Color="{StaticResource PartnerTealStrongColor}" />
  <SolidColorBrush x:Key="TealTintBrush" Color="{StaticResource TealTintColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessTintBrush" Color="{StaticResource SuccessTintColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="WarningTintBrush" Color="{StaticResource WarningTintColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerTintBrush" Color="{StaticResource DangerTintColor}" />
  <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="{StaticResource DisabledSurfaceColor}" />
  <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
  <SolidColorBrush x:Key="FocusBrush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
</ResourceDictionary>
