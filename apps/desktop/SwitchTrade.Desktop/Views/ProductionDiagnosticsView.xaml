<UserControl x:Class="SwitchTrade.Desktop.Views.ProductionDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:model="clr-namespace:SwitchTrade.Desktop.Models">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,6,12,48">
      <TextBlock Text="PRODUCTION DIAGNOSTICS" Style="{StaticResource KickerText}" Margin="0,0,0,8" />
      <TextBlock Text="Debug menu" Style="{StaticResource ScreenTitle}"
                 automation:AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Text="Validate this PC before a physically separated two-PC/two-Switch test. These checks use the installed production wrapper and relay; they never open a public room."
                 Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,18" />

      <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Selected adapter" Style="{StaticResource FieldLabel}" />
          <TextBlock Text="{Binding AdapterText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
      </Border>

      <TextBlock Text="Tests" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
      <WrapPanel Margin="0,0,0,18">
        <Button Content="Run automated system check" Command="{Binding StartCommand}"
                CommandParameter="{x:Static model:ProductionDiagnosticTest.Automated}"
                Style="{StaticResource PrimaryButton}" Margin="0,0,10,10" />
        <Button Content="Detect a Switch room" Command="{Binding StartCommand}"
                CommandParameter="{x:Static model:ProductionDiagnosticTest.RoomDetection}"
                Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
        <Button Content="Test Switch AP association" Command="{Binding StartCommand}"
                CommandParameter="{x:Static model:ProductionDiagnosticTest.ApAssociation}"
                Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
        <Button Content="Run recommended local suite" Command="{Binding StartCommand}"
                CommandParameter="{x:Static model:ProductionDiagnosticTest.Recommended}"
                Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
      </WrapPanel>

      <Border Style="{StaticResource WarningNotice}" Visibility="{Binding HasCheckpoint, Converter={StaticResource BooleanToVisibility}}">
        <StackPanel>
          <TextBlock Text="Your action is required" FontWeight="SemiBold" Margin="0,0,0,5" />
          <TextBlock Text="{Binding CheckpointInstructions}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CheckpointDeadline}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
          <Button Content="Continue" Command="{Binding ContinueCommand}" Style="{StaticResource PrimaryButton}"
                  HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="0,16,0,0"
              Visibility="{Binding HasRun, Converter={StaticResource BooleanToVisibility}}">
        <StackPanel>
          <TextBlock Text="Run status" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding CurrentStage}" FontFamily="{StaticResource MonoFontFamily}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" Margin="0,8,0,0" />
          <ItemsControl ItemsSource="{Binding Stages}" Margin="0,14,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,6,0,0">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}">
                      <Run Text="{Binding Status}" /><Run Text=" · " /><Run Text="{Binding Code}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Margin="0,16,0,0">
            <Button Content="Cancel and clean up" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}"
                    Margin="0,0,10,0" />
            <Button Content="Run again" Command="{Binding RunAgainCommand}" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,10,0" />
            <Button Content="Create support file" Command="{Binding SupportCommand}" Style="{StaticResource SecondaryButton}" />
          </WrapPanel>
          <TextBlock Text="{Binding SupportFilePath}" FontFamily="{StaticResource MonoFontFamily}"
                     FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
      </Border>

      <TextBlock Text="Physical checks do not prove a completed trade. For AP association, use one searching Switch only; do not have another Switch host a room."
                 Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,18,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
