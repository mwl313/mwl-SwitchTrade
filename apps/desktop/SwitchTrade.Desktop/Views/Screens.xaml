<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
                    xmlns:vm="clr-namespace:SwitchTrade.Desktop.ViewModels"
                    xmlns:model="clr-namespace:SwitchTrade.Desktop.Models">

  <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

  <DataTemplate DataType="{x:Type vm:StartupScreenViewModel}">
    <Grid MinHeight="480">
      <StackPanel Width="440" HorizontalAlignment="Left" VerticalAlignment="Center">
        <TextBlock Text="Starting SwitchTrade…" Style="{StaticResource ScreenTitle}"
                   TextAlignment="Center" automation:AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="Preparing the app so you can connect two Switches."
                   Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center"
                   Margin="0,0,0,28" />
        <ProgressBar Height="4" IsIndeterminate="True" Foreground="{DynamicResource LinkBlueBrush}"
                     Margin="0,0,0,24" />
        <StackPanel Margin="34,0">
          <TextBlock Text="Preparing the app" Margin="0,0,0,10" />
          <TextBlock Text="Connecting online" Margin="0,0,0,10" />
          <TextBlock Text="Checking your Wi-Fi adapter" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:RecoveryScreenViewModel}">
    <StackPanel Width="640" HorizontalAlignment="Left" Margin="0,56,0,0">
      <TextBlock Text="SwitchTrade couldn’t start" Style="{StaticResource ScreenTitle}" />
      <TextBlock Text="The installed local service is not available. Try again, or open Settings to check this computer’s setup."
                 FontSize="16" LineHeight="24" Margin="0,0,0,24" />
      <Border Style="{StaticResource SurfaceCard}">
        <StackPanel>
          <TextBlock Text="What you can do" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="If SwitchTrade is fully installed, Retry will start its private runtime automatically. A standalone EXE can still open an explicitly labeled interface preview."
                     Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,20" />
          <StackPanel Orientation="Horizontal">
            <Button Content="Try again" Command="{Binding RetryCommand}" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,12,0" automation:AutomationProperties.Name="Try starting SwitchTrade again" />
            <Button Content="Settings" Command="{Binding SettingsCommand}" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,12,0" />
            <Button Content="View interface preview" Command="{Binding PreviewCommand}" Style="{StaticResource TextButton}" />
          </StackPanel>
          <Expander Header="Technical details" Margin="0,20,0,0">
            <TextBlock Text="The desktop app could not reach the local control service at 127.0.0.1:8787. No online or Switch connection has been started."
                       Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
          </Expander>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:HomeScreenViewModel}">
    <StackPanel Width="640" HorizontalAlignment="Left" Margin="0,46,0,0">
      <TextBlock Text="Trade Pokémon with another trainer" Style="{StaticResource ScreenTitle}" />
      <TextBlock Text="Create a private space, share its code, and follow the steps for each Switch."
                 FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,28" />
      <Border Style="{StaticResource InlineNotice}"
              Visibility="{Binding ShowAttention, Converter={StaticResource BooleanToVisibility}}">
        <TextBlock Text="{Binding AttentionText}" />
      </Border>
      <Button Content="Create a Trade Room" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}"
              HorizontalContentAlignment="Left" Margin="0,0,0,12"
              automation:AutomationProperties.HelpText="Create a room and share its code with another trainer" />
      <Button Content="Browse Public Rooms" Command="{Binding PublicCommand}" Style="{StaticResource SecondaryButton}"
              HorizontalContentAlignment="Left" Margin="0,0,0,12"
              automation:AutomationProperties.HelpText="Browse interactive sample rooms in this build" />
      <Button Content="Have a room code? Join a private room" Command="{Binding JoinCommand}"
              Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" />
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:CreateTradeRoomScreenViewModel}">
    <StackPanel Width="640" HorizontalAlignment="Left">
      <TextBlock Text="Create a Trade Room" Style="{StaticResource ScreenTitle}" />
      <TextBlock Text="Choose how another trainer can find you."
                 Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,24" />
      <Border Style="{StaticResource SurfaceCard}">
        <StackPanel>
          <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,18">
            <Run Text="Fields marked " /><Run Text="*" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" /><Run Text=" are required." />
          </TextBlock>

          <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">
            <Run Text="Room name" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" />
          </TextBlock>
          <TextBox Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}" MaxLength="22"
                   automation:AutomationProperties.Name="Room name" Margin="0,0,0,20" />

          <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">
            <Run Text="Trainer display name" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" />
          </TextBlock>
          <TextBox Text="{Binding TrainerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"
                   automation:AutomationProperties.Name="Trainer display name" Margin="0,0,0,20" />

          <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">
                <Run Text="Game" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" />
              </TextBlock>
              <ComboBox ItemsSource="{Binding GameVersions}" SelectedItem="{Binding GameVersion}"
                        automation:AutomationProperties.Name="Game version" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">
                <Run Text="Language" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" />
              </TextBlock>
              <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                        automation:AutomationProperties.Name="Game language" />
            </StackPanel>
          </Grid>

          <TextBlock Text="Room access" FontWeight="SemiBold" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <RadioButton Content="Private room" GroupName="RoomVisibility"
                         IsChecked="{Binding IsPrivateRoom, Mode=TwoWay}" Margin="0,0,28,0" />
            <RadioButton Content="Public room — Preview" GroupName="RoomVisibility"
                         IsChecked="{Binding IsPublicPreview, Mode=TwoWay}" />
          </StackPanel>

          <Border Style="{StaticResource InlineNotice}"
                  Visibility="{Binding IsPublicPreview, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="Public Rooms Preview — this form creates a visual preview from sample data. It does not publish a live room." />
          </Border>

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Offering (optional)" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBox Text="{Binding Offering, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Looking for (optional)" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBox Text="{Binding Wanted, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="Short note (optional)" FontWeight="SemiBold" Margin="0,0,0,8" />
          <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="120"
                   AcceptsReturn="True" Height="72" />

          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                     Margin="0,16,0,0" automation:AutomationProperties.LiveSetting="Assertive"
                     Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}" />
          <TextBlock Text="Private rooms require the installed SwitchTrade service. Public rooms remain a labeled preview in this build."
                     Style="{StaticResource SecondaryText}" Margin="0,18,0,0" />
          <Button Content="{Binding SubmitText}" Command="{Binding CreateCommand}"
                  Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:JoinPrivateRoomScreenViewModel}">
    <StackPanel Width="640" HorizontalAlignment="Left" Margin="0,30,0,0">
      <TextBlock Text="Join a private Trade Room" Style="{StaticResource ScreenTitle}" />
      <TextBlock Text="Enter the room code shared by the other trainer. Spaces and hyphens are removed automatically."
                 Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,24" />
      <Border Style="{StaticResource SurfaceCard}">
        <StackPanel>
          <TextBlock Text="Room code" FontWeight="SemiBold" Margin="0,0,0,8" />
          <TextBox Text="{Binding RoomCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"
                   CharacterCasing="Upper" FontFamily="Cascadia Mono" FontSize="20"
                   automation:AutomationProperties.Name="Private Trade Room code" />
          <Button Content="Find Trade Room" Command="{Binding FindCommand}" Style="{StaticResource PrimaryButton}"
                  Margin="0,16,0,0" />
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                     Margin="0,16,0,0" automation:AutomationProperties.LiveSetting="Assertive"
                     Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}" />

          <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="6" Padding="18"
                  Margin="0,20,0,0" Visibility="{Binding HasResolvedRoom, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
              <TextBlock Text="Trade Room found" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,8" />
              <TextBlock Text="{Binding ResolvedRoom.Name}" FontSize="16" />
              <TextBlock Text="Private · occupancy is not authoritative in this build"
                         Style="{StaticResource SecondaryText}" Margin="0,4,0,14" />
              <Button Content="Join Trade Room" Command="{Binding JoinCommand}" Style="{StaticResource SecondaryButton}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:PublicRoomsScreenViewModel}">
    <StackPanel HorizontalAlignment="Stretch">
      <TextBlock Text="Browse Public Rooms" Style="{StaticResource ScreenTitle}" />
      <Border Style="{StaticResource InlineNotice}">
        <TextBlock Text="Public Rooms Preview — sample data in this build. Search, filters, sorting, and previews work locally; no remote trainer is contacted." />
      </Border>

      <WrapPanel Margin="0,0,0,16">
        <ComboBox Width="150" ItemsSource="{Binding SearchByOptions}" SelectedItem="{Binding SearchBy}" Margin="0,0,8,8"
                  automation:AutomationProperties.Name="Search by" />
        <TextBox Width="250" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,8"
                 automation:AutomationProperties.Name="Search public room samples" />
        <ComboBox Width="130" ItemsSource="{Binding AvailabilityOptions}" SelectedItem="{Binding Availability}" Margin="0,0,8,8" />
        <ComboBox Width="120" ItemsSource="{Binding GameOptions}" SelectedItem="{Binding Game}" Margin="0,0,8,8" />
        <ComboBox Width="130" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" Margin="0,0,8,8" />
        <ComboBox Width="150" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" Margin="0,0,8,8" />
        <Button Content="Clear" Command="{Binding ClearFiltersCommand}" Style="{StaticResource TextButton}" Margin="0,0,4,8" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource TextButton}" Margin="0,0,0,8" />
      </WrapPanel>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" MinWidth="380" />
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="2*" MinWidth="300" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource SurfaceCard}" Padding="0">
          <ListBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}"
                   BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                   automation:AutomationProperties.Name="Public room preview results">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type model:PublicRoomSummary}">
                <Grid Margin="18,14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding RoomName}" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="{Binding TrainerDisplayName, StringFormat=Trainer: {0}}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Offering, StringFormat=Offering: {0}}" Style="{StaticResource SecondaryText}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Availability}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding ConnectionQuality}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" Margin="0,5,0,0" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
          <Grid>
            <TextBlock Text="Select a sample room to see its details."
                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibility}}">
              <Border Style="{StaticResource DemoBadge}" HorizontalAlignment="Left" Margin="0,0,0,14">
                <TextBlock Text="Demo Preview" Foreground="{DynamicResource LinkBlueBrush}" FontSize="12" FontWeight="SemiBold" />
              </Border>
              <TextBlock Text="{Binding SelectedRoom.RoomName}" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding SelectedRoom.TrainerDisplayName, StringFormat=Trainer: {0}}" Margin="0,0,0,14" />
              <TextBlock Text="{Binding SelectedRoom.GameVersion, StringFormat=Game: {0}}" />
              <TextBlock Text="{Binding SelectedRoom.Language, StringFormat=Language: {0}}" />
              <TextBlock Text="{Binding SelectedRoom.Offering, StringFormat=Offering: {0}}" />
              <TextBlock Text="{Binding SelectedRoom.Wanted, StringFormat=Looking for: {0}}" />
              <TextBlock Text="{Binding SelectedRoom.Region, StringFormat=Region: {0}}" />
              <TextBlock Text="{Binding SelectedRoom.ConnectionQuality, StringFormat=Connection quality: {0}}" />
              <TextBlock Text="{Binding SelectedRoom.Note}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,14,0,20" />
              <Button Content="Preview Trade Room" Command="{Binding PreviewCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <TextBlock Text="No open rooms match these filters." Margin="0,24,0,0" TextAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding HasRooms}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SettingsScreenViewModel}">
    <StackPanel Width="640" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource ScreenTitle}" />
      <TabControl Margin="0,14,0,0">
        <TabItem Header="Connection">
          <StackPanel Margin="24">
            <TextBlock Text="Wi-Fi adapter" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,18" />
            <ItemsControl ItemsSource="{Binding Adapters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type model:AdapterProfileViewData}">
                  <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                      <Grid>
                        <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="{Binding SupportLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryTextBrush}" />
                      </Grid>
                      <TextBlock Text="{Binding Summary}" Margin="0,5,0,0" />
                      <Expander Header="Technical details" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TechnicalDetails}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
                      </Expander>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Check again" Command="{Binding RecheckCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
          </StackPanel>
        </TabItem>
        <TabItem Header="Support">
          <StackPanel Margin="24">
            <TextBlock Text="Support" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Create a redacted support file when a recovery step does not work." Margin="0,0,0,18" />
            <Button Content="Create support file" Command="{Binding SupportCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
            <TextBlock Text="SwitchTrade 0.2.0 beta" Style="{StaticResource SecondaryText}" Margin="0,20,0,0" />
          </StackPanel>
        </TabItem>
        <TabItem Header="Advanced">
          <StackPanel Margin="24">
            <TextBlock Text="Advanced" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Driver, USB, and runtime details appear here only for troubleshooting. The RTL8188EU remains test-only and is not selected for normal trading." />
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:TradeRoomScreenViewModel}">
    <StackPanel HorizontalAlignment="Stretch">
      <Grid Margin="0,0,0,18">
        <StackPanel>
          <TextBlock Text="{Binding RoomName}" Style="{StaticResource ScreenTitle}" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding VisibilityLabel}" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Text="  ·  " Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Text="{Binding ConnectionStatus}" Foreground="{DynamicResource SecondaryTextBrush}"
                       automation:AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </StackPanel>
        <Border Style="{StaticResource DemoBadge}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Visibility="{Binding IsDemoPreview, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Text="Demo Preview" Foreground="{DynamicResource LinkBlueBrush}" FontWeight="SemiBold" />
        </Border>
      </Grid>

      <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,18">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{DynamicResource BlueTintBrush}" CornerRadius="8" Padding="18">
            <StackPanel>
              <TextBlock Text="You" FontWeight="SemiBold" FontSize="18" />
              <TextBlock Text="{Binding YouSummary}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
            </StackPanel>
          </Border>
          <Grid Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
            <Border Height="1" Background="{DynamicResource BorderBrush}" />
            <Ellipse Width="10" Height="10" Fill="{DynamicResource LinkBlueBrush}" HorizontalAlignment="Left" />
            <Ellipse Width="10" Height="10" Fill="{DynamicResource PartnerTealBrush}" HorizontalAlignment="Right" />
          </Grid>
          <Border Grid.Column="2" Background="{DynamicResource TealTintBrush}" CornerRadius="8" Padding="18">
            <StackPanel>
              <TextBlock Text="Partner" FontWeight="SemiBold" FontSize="18" />
              <TextBlock Text="{Binding PartnerSummary}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Style="{StaticResource InlineNotice}" Visibility="{Binding IsRealRoom, Converter={StaticResource BooleanToVisibility}}">
        <TextBlock Text="{Binding LimitationNotice}" />
      </Border>

      <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,18"
              Visibility="{Binding IsRealRoom, Converter={StaticResource BooleanToVisibility}}">
        <StackPanel>
          <TextBlock Text="{Binding MainInstruction}" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding InstructionDetails}" FontSize="16" LineHeight="24" Margin="0,0,0,20" />
          <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="6" Padding="16"
                  Visibility="{Binding HasRoomCode, Converter={StaticResource BooleanToVisibility}}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Room code" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding RoomCode}" FontFamily="Cascadia Mono" FontWeight="SemiBold" FontSize="20" />
              </StackPanel>
              <Button Grid.Column="1" Content="Copy code" Command="{Binding CopyCodeCommand}" Style="{StaticResource TextButton}" />
              <Button Grid.Column="3" Content="Copy invitation" Command="{Binding CopyInvitationCommand}" Style="{StaticResource TextButton}" />
            </Grid>
          </Border>
          <Button Content="{Binding ConnectionActionText}" Command="{Binding ConnectionCommand}"
                  Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,20,0,0" />
          <TextBlock Text="Party details will appear here after the passive live decoder is connected. Trading does not depend on party display."
                     Style="{StaticResource SecondaryText}" Margin="0,20,0,0" />
        </StackPanel>
      </Border>

      <StackPanel Visibility="{Binding IsDemoPreview, Converter={StaticResource BooleanToVisibility}}">
        <Border Style="{StaticResource InlineNotice}">
          <TextBlock Text="{Binding InstructionDetails}" />
        </Border>
        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,18"
                BorderBrush="{DynamicResource LinkBlueBrush}"
                Visibility="{Binding HasSelectedPokemon, Converter={StaticResource BooleanToVisibility}}"
                automation:AutomationProperties.LiveSetting="Polite">
          <StackPanel>
            <Grid>
              <StackPanel>
                <TextBlock Text="{Binding SelectedPokemon.Nickname}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding SelectedPokemon.Species, StringFormat={}{0} · Verified sample}" Foreground="{DynamicResource SecondaryTextBrush}" />
              </StackPanel>
              <TextBlock Text="Press Escape to close" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}" />
            </Grid>
            <Separator Margin="0,16" />
            <TextBlock Text="{Binding SelectedPokemon.Nature, StringFormat=Nature: {0}}" />
            <TextBlock Text="{Binding SelectedPokemon.HeldItem, StringFormat=Held item: {0}}" />
            <TextBlock Text="{Binding SelectedPokemon.Stats, StringFormat=Stats: {0}}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding SelectedPokemon.Ivs, StringFormat=IVs: {0}}" />
            <TextBlock Text="{Binding SelectedPokemon.Evs, StringFormat=EVs: {0}}" />
            <TextBlock Text="{Binding SelectedPokemon.Moves, StringFormat=Moves: {0}}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding SelectedPokemon.Trainer, StringFormat=Trainer: {0}}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
            <StackPanel>
              <TextBlock Text="You" Style="{StaticResource SectionTitle}" />
              <ItemsControl ItemsSource="{Binding YouParty.Slots}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="2" Rows="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type model:PokemonViewData}">
                    <Button Command="{Binding DataContext.CurrentScreen.SelectPokemonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}"
                            Margin="4" MinHeight="100" HorizontalContentAlignment="Left"
                            automation:AutomationProperties.Name="{Binding AccessibleName}">
                      <Button.ToolTip>
                        <StackPanel MaxWidth="280">
                          <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Species}" />
                          <TextBlock Text="Select to pin sample details" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                        </StackPanel>
                      </Button.ToolTip>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource BlueTintBrush}">
                          <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                          <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Species}" Style="{StaticResource SecondaryText}" />
                          <TextBlock Text="{Binding LevelText}" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
            <StackPanel>
              <TextBlock Text="Partner" Style="{StaticResource SectionTitle}" />
              <ItemsControl ItemsSource="{Binding PartnerParty.Slots}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="2" Rows="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type model:PokemonViewData}">
                    <Button Command="{Binding DataContext.CurrentScreen.SelectPokemonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}"
                            Margin="4" MinHeight="100" HorizontalContentAlignment="Left"
                            automation:AutomationProperties.Name="{Binding AccessibleName}">
                      <Button.ToolTip>
                        <StackPanel MaxWidth="280">
                          <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Species}" />
                          <TextBlock Text="Select to pin sample details" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                        </StackPanel>
                      </Button.ToolTip>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource TealTintBrush}">
                          <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                          <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Species}" Style="{StaticResource SecondaryText}" />
                          <TextBlock Text="{Binding LevelText}" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

      </StackPanel>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
