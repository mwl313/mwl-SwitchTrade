                    xmlns:vm="clr-namespace:SwitchTrade.Desktop.ViewModels"
                    xmlns:views="clr-namespace:SwitchTrade.Desktop.Views">
  <DataTemplate DataType="{x:Type vm:StartupScreenViewModel}"><views:StartupView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:RecoveryScreenViewModel}"><views:RecoveryView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:HomeScreenViewModel}"><views:HomeView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:CreateTradeRoomScreenViewModel}"><views:CreateTradeRoomView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:JoinPrivateRoomScreenViewModel}"><views:JoinPrivateRoomView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:PublicRoomsScreenViewModel}"><views:PublicRoomsView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:SettingsScreenViewModel}"><views:SettingsView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:ProductionDiagnosticsScreenViewModel}"><views:ProductionDiagnosticsView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:TradeRoomScreenViewModel}"><views:TradeRoomView /></DataTemplate>
</ResourceDictionary>
