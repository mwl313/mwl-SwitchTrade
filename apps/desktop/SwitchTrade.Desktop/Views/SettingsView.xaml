<UserControl x:Class="SwitchTrade.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:model="clr-namespace:SwitchTrade.Desktop.Models"
             xmlns:vm="clr-namespace:SwitchTrade.Desktop.ViewModels">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="SYSTEM" Style="{StaticResource KickerText}" Margin="0,0,0,8" />
      <TextBlock Text="Settings" Style="{StaticResource ScreenTitle}"
                 automation:AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,18" />
    </StackPanel>

    <TabControl Grid.Row="1" SelectedValuePath="Tag" SelectedValue="{Binding SelectedSection}"
                Style="{StaticResource SettingsTabControl}"
                ItemContainerStyle="{StaticResource SettingsTabItem}"
                automation:AutomationProperties.Name="Settings tabs">
      <TabItem Header="Connection" Tag="{x:Static vm:SettingsSection.Connection}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="18,22,12,32">
            <TextBlock Text="Connection" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Local setup" Foreground="{DynamicResource LinkBlueBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,20" />
            <TextBlock Text="Detected USB Wi-Fi adapter" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                      DisplayMemberPath="DisplayLabel" MaxWidth="560" HorizontalAlignment="Left"
                      automation:AutomationProperties.Name="Detected USB Wi-Fi adapter" />
            <TextBlock Text="{Binding DeviceDisclaimer}" Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap" Margin="0,7,0,0" />
            <Button Content="Use selected adapter" Command="{Binding SelectDeviceCommand}"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,22" />
            <TextBlock Text="Adapter diagnostics" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="This check temporarily attaches the selected adapter to SwitchTrade, verifies its Linux driver, and returns it to its prior Windows state."
                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                      DisplayMemberPath="FriendlyName" MaxWidth="420" HorizontalAlignment="Left"
                      automation:AutomationProperties.Name="Diagnostic adapter profile" />
            <Button Content="Run adapter check" Command="{Binding DiagnosticCommand}"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
            <TextBlock Text="{Binding DiagnosticFilePath}" FontFamily="{StaticResource MonoFontFamily}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
            <Button Content="Check again" Command="{Binding RecheckCommand}" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Margin="0,20,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Support" Tag="{x:Static vm:SettingsSection.Support}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="18,22,12,32">
            <TextBlock Text="Support" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Create a redacted support file on your Desktop. SwitchTrade also sends it to the online relay when available." Margin="0,0,0,18" TextWrapping="Wrap" />
            <Button Content="Create support file" Command="{Binding SupportCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
            <Border Style="{StaticResource SuccessNotice}" Margin="0,18,0,0"
                    Visibility="{Binding HasSupportFile, Converter={StaticResource BooleanToVisibility}}">
              <StackPanel>
                <TextBlock Text="Support file created" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="{Binding SupportFilePath}" FontFamily="{StaticResource MonoFontFamily}" FontSize="13" />
                <Button Content="Copy location" Command="{Binding CopySupportPathCommand}" Style="{StaticResource TextButton}"
                        HorizontalAlignment="Left" Margin="-10,6,0,-6" />
              </StackPanel>
            </Border>
            <TextBlock Margin="0,18,0,0" TextWrapping="Wrap">
              Report a problem and attach the support file at
              <Hyperlink NavigateUri="https://github.com/mwl313/mwl-SwitchTrade/issues"
                         RequestNavigate="OpenSupportPage">SwitchTrade GitHub Issues</Hyperlink>.
            </TextBlock>
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,28" />
            <TextBlock Text="About SwitchTrade" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="SwitchTrade 0.2.2 beta.1" />
            <TextBlock Text="Room control v1 · Public directory v1 · Party commit v1" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Advanced" Tag="{x:Static vm:SettingsSection.Advanced}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="18,22,12,32">
            <TextBlock Text="Advanced" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Production diagnostics" FontWeight="SemiBold" Margin="0,4,0,8" />
            <TextBlock Text="Run repeatable checks on this PC before separating two computers and two Switches. Diagnostics use the installed wrapper, selected USB adapter, hosted relay, and production radio path." TextWrapping="Wrap" />
            <TextBlock Text="The selected adapter is temporarily controlled during a run. No public Trade Room is created, and a passed result does not certify a complete physical trade." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <Button Content="Open debug menu" Command="{Binding OpenDiagnosticsCommand}"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
