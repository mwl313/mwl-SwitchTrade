<UserControl x:Class="SwitchTrade.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:model="clr-namespace:SwitchTrade.Desktop.Models"
             xmlns:vm="clr-namespace:SwitchTrade.Desktop.ViewModels">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <TextBlock Text="Settings" Style="{StaticResource ScreenTitle}"
               automation:AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,18" />

    <TabControl Grid.Row="1" SelectedValuePath="Tag" SelectedValue="{Binding SelectedSection}"
                Style="{StaticResource SettingsTabControl}"
                ItemContainerStyle="{StaticResource SettingsTabItem}"
                automation:AutomationProperties.Name="Settings tabs">
      <TabItem Header="Connection" Tag="{x:Static vm:SettingsSection.Connection}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="18,22,12,32">
            <TextBlock Text="Connection" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Local setup" Foreground="{DynamicResource LinkBlueBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,20" />
            <TextBlock Text="Wi-Fi adapters" FontWeight="SemiBold" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding Adapters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type model:AdapterProfileViewData}">
                  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                    <StackPanel>
                      <Grid>
                        <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="{Binding SupportLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryTextBrush}" />
                      </Grid>
                      <TextBlock Text="{Binding Summary}" Margin="0,5,0,0" />
                      <Expander Header="Technical details" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TechnicalDetails}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
                      </Expander>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Diagnostic profile" FontWeight="SemiBold" Margin="0,20,0,6" />
            <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                      DisplayMemberPath="FriendlyName" MaxWidth="420" HorizontalAlignment="Left"
                      automation:AutomationProperties.Name="Diagnostic adapter profile" />
            <Button Content="Run read-only diagnostics" Command="{Binding DiagnosticCommand}"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
            <TextBlock Text="{Binding DiagnosticFilePath}" FontFamily="Cascadia Mono, Consolas"
                       FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
            <Button Content="Check again" Command="{Binding RecheckCommand}" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Margin="0,20,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Support" Tag="{x:Static vm:SettingsSection.Support}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="18,22,12,32">
            <TextBlock Text="Support" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Create a redacted support file when a recovery step does not work." Margin="0,0,0,18" />
            <Button Content="Create support file" Command="{Binding SupportCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
            <Border Style="{StaticResource SuccessNotice}" Margin="0,18,0,0"
                    Visibility="{Binding HasSupportFile, Converter={StaticResource BooleanToVisibility}}">
              <StackPanel>
                <TextBlock Text="Support file created" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="{Binding SupportFilePath}" FontFamily="Cascadia Mono, Consolas" FontSize="13" />
                <Button Content="Copy location" Command="{Binding CopySupportPathCommand}" Style="{StaticResource TextButton}"
                        HorizontalAlignment="Left" Margin="-10,6,0,-6" />
              </StackPanel>
            </Border>
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,28" />
            <TextBlock Text="About SwitchTrade" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="SwitchTrade 0.2.0 beta" />
            <TextBlock Text="Room control v1 · Party commit v1" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Advanced" Tag="{x:Static vm:SettingsSection.Advanced}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="18,22,12,32">
            <TextBlock Text="Advanced" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource WarningNotice}">
              <TextBlock Text="Quarantined cards are blocked. Research and driver candidates require explicit consent for every trading attempt." />
            </Border>
            <TextBlock Text="Host/AP engines" FontWeight="SemiBold" Margin="0,18,0,8" />
            <TextBlock Text="HostTransport + ldn.create_network() — Available and default" />
            <TextBlock Text="hostapd AP engine — In Development (not selectable)" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
            <TextBlock Text="direct nl80211 AP engine — In Development (not selectable)" Style="{StaticResource SecondaryText}" Margin="0,5,0,16" />
            <TextBlock Text="Driver, USB, and runtime details appear here only for troubleshooting. Normal trading should not require this section." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
