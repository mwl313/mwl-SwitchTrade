<UserControl x:Class="SwitchTrade.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
  <UserControl.Resources>
    <Style x:Key="HomeActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Height" Value="56" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
              <Border x:Name="FocusRing" CornerRadius="9" BorderThickness="2"
                      BorderBrush="{DynamicResource FocusBrush}" Opacity="0" />
              <Border x:Name="ButtonBorder" Margin="4" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6" Padding="{TemplateBinding Padding}">
                <Grid x:Name="ContentRoot" RenderTransformOrigin="0.5,0.5">
                  <Grid.RenderTransform><TranslateTransform Y="0" /></Grid.RenderTransform>
                  <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    RecognizesAccessKey="True" />
                  <Border x:Name="InteractionOverlay" Background="White" Opacity="0"
                          CornerRadius="5" IsHitTestVisible="False" />
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.08" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush"
                        Value="{DynamicResource BorderStrongBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.16" />
                <Setter TargetName="ContentRoot" Property="RenderTransform">
                  <Setter.Value><TranslateTransform Y="1" /></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Width="620" MaxWidth="620" HorizontalAlignment="Left" Margin="0,56,0,28">
      <Border Style="{StaticResource WarningNotice}"
              Visibility="{Binding ShowAttention, Converter={StaticResource BooleanToVisibility}}">
        <TextBlock Text="{Binding AttentionText}" />
      </Border>

      <Button Content="Create Room" Command="{Binding CreateCommand}"
              Style="{StaticResource HomeActionButton}" Margin="0,0,0,10"
              automation:AutomationProperties.Name="Create Room" />
      <Button Content="Join Private Room" Command="{Binding JoinCommand}"
              Style="{StaticResource HomeActionButton}" Margin="0,0,0,10"
              automation:AutomationProperties.Name="Join Private Room" />
      <Button Content="Browse Public Rooms" Command="{Binding PublicCommand}"
              Style="{StaticResource HomeActionButton}"
              automation:AutomationProperties.Name="Browse Public Rooms" />

      <Border Style="{StaticResource SurfaceCard}" Margin="0,24,0,0" Padding="18">
        <StackPanel>
          <TextBlock Text="Wi-Fi adapter" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                    DisplayMemberPath="DisplayLabel" Foreground="{DynamicResource PrimaryTextBrush}"
                    SelectionChanged="AdapterSelectionChanged"
                    automation:AutomationProperties.Name="Wi-Fi adapter" />
          <TextBlock Text="{Binding AdapterStatus}" Style="{StaticResource SecondaryText}"
                     TextWrapping="Wrap" Margin="0,8,0,0"
                     automation:AutomationProperties.LiveSetting="Polite" />
          <Button Content="Authorize adapter" Command="{Binding AuthorizeAdapterCommand}"
                  Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"
                  Visibility="{Binding NeedsAdapterAuthorization, Converter={StaticResource BooleanToVisibility}}"
                  automation:AutomationProperties.Name="Authorize adapter" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
