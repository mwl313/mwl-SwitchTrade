<UserControl x:Class="SwitchTrade.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="620" HorizontalAlignment="Left" Margin="0,56,0,28">
      <Border Style="{StaticResource WarningNotice}"
              Visibility="{Binding ShowAttention, Converter={StaticResource BooleanToVisibility}}">
        <TextBlock Text="{Binding AttentionText}" />
      </Border>

      <Button Content="Create Room" Command="{Binding CreateCommand}"
              Style="{StaticResource PrimaryButton}" Height="62" FontSize="17" Margin="0,0,0,10"
              automation:AutomationProperties.Name="Create Room" />
      <Button Content="Join Private Room" Command="{Binding JoinCommand}"
              Style="{StaticResource SecondaryButton}" Height="56" FontSize="16" Margin="0,0,0,10"
              automation:AutomationProperties.Name="Join Private Room" />
      <Button Content="Browse Public Rooms" Command="{Binding PublicCommand}"
              Style="{StaticResource SecondaryButton}" Height="56" FontSize="16"
              automation:AutomationProperties.Name="Browse Public Rooms" />

      <Border Style="{StaticResource SurfaceCard}" Margin="0,24,0,0" Padding="18">
        <StackPanel>
          <TextBlock Text="Wi-Fi adapter" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                    DisplayMemberPath="DisplayLabel" Foreground="{DynamicResource PrimaryTextBrush}"
                    SelectionChanged="AdapterSelectionChanged"
                    automation:AutomationProperties.Name="Wi-Fi adapter" />
          <TextBlock Text="{Binding AdapterStatus}" Style="{StaticResource SecondaryText}"
                     TextWrapping="Wrap" Margin="0,8,0,0"
                     automation:AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
