<UserControl x:Class="SwitchTrade.Desktop.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="0,36,0,32">
      <Path Data="{StaticResource Icon.Warning}" Width="32" Height="32" Stretch="Uniform"
            Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.8" HorizontalAlignment="Left" Margin="0,0,0,16" />
      <TextBlock Text="SwitchTrade needs attention" Style="{StaticResource ScreenTitle}"
                 automation:AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Text="SwitchTrade found a problem that needs a clear recovery choice."
                 FontSize="16" LineHeight="24" Margin="0,0,0,24" />
      <Border Style="{StaticResource ErrorNotice}">
        <StackPanel>
          <TextBlock Text="{Binding RecoverySummary}" FontWeight="SemiBold" Margin="0,0,0,4" />
          <TextBlock Text="{Binding RecoveryInstructions}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <WrapPanel Margin="-4,0,0,0">
        <Button Content="Try again" Command="{Binding RetryCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
        <Button Content="Connection settings" Command="{Binding SettingsCommand}" Style="{StaticResource SecondaryButton}"
                Visibility="{Binding ShowConnectionSettings, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,8,8" />
        <Button Content="Forget saved room" Command="{Binding AbandonLocalAuthorityCommand}"
                Style="{StaticResource DangerButton}"
                Visibility="{Binding ShowAbandonLocalAuthority, Converter={StaticResource BooleanToVisibility}}"
                Margin="0,0,8,8" />
        <Button Content="Return home" Command="{Binding ReturnHomeCommand}"
                Style="{StaticResource PrimaryButton}"
                Visibility="{Binding ShowReturnHome, Converter={StaticResource BooleanToVisibility}}"
                Margin="0,0,8,8" />
        <Button Content="Export support logs" Command="{Binding SupportCommand}"
                Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
      </WrapPanel>
      <Expander Header="Technical details" Margin="0,20,0,0">
        <TextBlock Text="{Binding RecoveryTechnicalDetails}"
                   Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
