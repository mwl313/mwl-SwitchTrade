<UserControl x:Class="SwitchTrade.Desktop.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="0,36,0,32">
      <Path Data="{StaticResource Icon.Warning}" Width="32" Height="32" Stretch="Uniform"
            Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.8" HorizontalAlignment="Left" Margin="0,0,0,16" />
      <TextBlock Text="SwitchTrade couldn’t start" Style="{StaticResource ScreenTitle}"
                 automation:AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Text="The installed local service is not available. Try again, or check this computer’s setup."
                 FontSize="16" LineHeight="24" Margin="0,0,0,24" />
      <Border Style="{StaticResource ErrorNotice}">
        <StackPanel>
          <TextBlock Text="The SwitchTrade service did not respond." FontWeight="SemiBold" Margin="0,0,0,4" />
          <TextBlock Text="No online room or Switch connection was started." />
        </StackPanel>
      </Border>
      <WrapPanel Margin="-4,0,0,0">
        <Button Content="Try again" Command="{Binding RetryCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
        <Button Content="Settings" Command="{Binding SettingsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
        <Button Content="View interface preview" Command="{Binding PreviewCommand}" Style="{StaticResource TextButton}" Margin="0,0,0,8" />
      </WrapPanel>
      <Expander Header="Technical details" Margin="0,20,0,0">
        <TextBlock Text="Local setup · The desktop app could not reach 127.0.0.1:8787."
                   Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
