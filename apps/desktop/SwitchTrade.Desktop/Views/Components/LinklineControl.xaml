<UserControl x:Class="SwitchTrade.Desktop.Views.Components.LinklineControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
  <Grid automation:AutomationProperties.Name="{Binding StatusText, ElementName=Root}">
    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="150" /><ColumnDefinition /></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource YouTintBrush}" CornerRadius="8" Padding="18">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="You" FontWeight="SemiBold" FontSize="18" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource ActionGreenBrush}" Margin="0,0,6,0" />
            <TextBlock Text="{Binding YouPresence, ElementName=Root}" Style="{StaticResource SecondaryText}" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding YouSummary, ElementName=Root}" Margin="0,5,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding YouSummary, ElementName=Root}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>
    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
      <Border Height="2" Background="{DynamicResource BorderStrongBrush}" />
      <Ellipse Width="12" Height="12" Fill="{DynamicResource YouBlueBrush}" HorizontalAlignment="Left" />
      <Border Background="{DynamicResource SurfaceBrush}" Padding="7,3" HorizontalAlignment="Center" CornerRadius="6">
        <TextBlock Text="{Binding StatusText, ElementName=Root}" Style="{StaticResource SecondaryText}" TextAlignment="Center" />
      </Border>
      <Ellipse Width="12" Height="12" Fill="{DynamicResource PartnerTealBrush}" HorizontalAlignment="Right" />
    </Grid>
    <Border Grid.Column="2" Background="{DynamicResource TealTintBrush}" CornerRadius="8" Padding="18">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="Partner" FontWeight="SemiBold" FontSize="18" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Margin="0,0,6,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource BorderStrongBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PartnerIsOnline, ElementName=Root}" Value="True">
                      <Setter Property="Fill" Value="{DynamicResource ActionGreenBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding PartnerPresence, ElementName=Root}" Style="{StaticResource SecondaryText}" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding PartnerSummary, ElementName=Root}" Margin="0,5,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding PartnerSummary, ElementName=Root}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
