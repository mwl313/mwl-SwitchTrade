<UserControl x:Class="SwitchTrade.Desktop.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
  <Grid MaxWidth="640" HorizontalAlignment="Left">
    <StackPanel Width="480" MaxWidth="480" HorizontalAlignment="Left" VerticalAlignment="Center">
      <TextBlock Text="Starting SwitchTrade" Style="{StaticResource ScreenTitle}"
                 automation:AutomationProperties.HeadingLevel="Level1"
                 automation:AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="Preparing the local SwitchTrade service…"
                 Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,24" />
      <ProgressBar Height="4" IsIndeterminate="True" Foreground="{DynamicResource LinkBlueBrush}" />
    </StackPanel>
  </Grid>
</UserControl>
