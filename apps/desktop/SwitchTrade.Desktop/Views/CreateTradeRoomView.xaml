<UserControl x:Class="SwitchTrade.Desktop.Views.CreateTradeRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
  <Grid HorizontalAlignment="Stretch">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,6,0,18">
      <TextBlock Text="NEW TRADE ROOM" Style="{StaticResource KickerText}" Margin="0,0,0,8" />
      <TextBlock Text="Create a Trade Room" Style="{StaticResource ScreenTitle}"
                 automation:AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Text="Set the details your partner will use to identify this room."
                 Foreground="{DynamicResource SecondaryTextBrush}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="0,0,12,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="7*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
          <StackPanel>
            <TextBlock Text="Required details" Style="{StaticResource SectionTitle}" />
            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,18">
              <Run Text="Fields marked " /><Run Text="*" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" /><Run Text=" are required." />
            </TextBlock>

            <TextBlock Style="{StaticResource FieldLabel}">
              <Run Text="Room name" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" />
            </TextBlock>
            <TextBox x:Name="RoomNameField" Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}" MaxLength="22"
                     automation:AutomationProperties.Name="Room name"
                     automation:AutomationProperties.IsRequiredForForm="True" Margin="0,0,0,16" />

            <TextBlock Style="{StaticResource FieldLabel}">
              <Run Text="Trainer display name" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" />
            </TextBlock>
            <TextBox Text="{Binding TrainerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"
                     automation:AutomationProperties.Name="Trainer display name"
                     automation:AutomationProperties.IsRequiredForForm="True" Margin="0,0,0,16" />

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}">
                  <Run Text="Game" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" />
                </TextBlock>
                <ComboBox ItemsSource="{Binding GameVersions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding GameVersion}" automation:AutomationProperties.Name="Game"
                          automation:AutomationProperties.IsRequiredForForm="True" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}">
                  <Run Text="Language" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" />
                </TextBlock>
                <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Language}" automation:AutomationProperties.Name="Language"
                          automation:AutomationProperties.IsRequiredForForm="True" />
              </StackPanel>
            </Grid>

            <Border Style="{StaticResource ErrorNotice}" Margin="0,16,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}"
                    automation:AutomationProperties.LiveSetting="Assertive">
              <TextBlock Text="{Binding ErrorMessage}" />
            </Border>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
          <StackPanel>
            <TextBlock Text="Room visibility" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <RadioButton Content="Private" GroupName="RoomVisibility"
                           IsChecked="{Binding IsPrivateRoom, Mode=TwoWay}" Margin="0,0,24,0" />
              <RadioButton Content="Public" GroupName="RoomVisibility"
                           IsChecked="{Binding IsPublicRoom, Mode=TwoWay}" />
            </StackPanel>
            <TextBlock Text="{Binding MetadataHelpText}" Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap" Margin="0,0,0,18" />

            <TextBlock Text="Offering (optional)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Offering, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Margin="0,0,0,12" />
            <TextBlock Text="Looking for (optional)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Wanted, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Margin="0,0,0,12" />
            <TextBlock Text="Short note (optional)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="120"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="76"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
          </StackPanel>
        </Border>

      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2" Style="{StaticResource StickyActionBar}">
      <Grid>
        <TextBlock Text="Your room stays open while SwitchTrade is running."
                   Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        <Button Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" MinWidth="190">
          <StackPanel Orientation="Horizontal">
            <ProgressBar IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
            <TextBlock Text="{Binding SubmitText}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
