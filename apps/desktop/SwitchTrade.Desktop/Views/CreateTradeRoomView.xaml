<UserControl x:Class="SwitchTrade.Desktop.Views.CreateTradeRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
  <Grid MaxWidth="640" HorizontalAlignment="Left">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="Create a Trade Room" Style="{StaticResource ScreenTitle}"
                 automation:AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Text="Set the room details another trainer will see in your invitation."
                 Foreground="{DynamicResource SecondaryTextBrush}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,24">
        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,20">
          <Run Text="Fields marked " /><Run Text="*" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" /><Run Text=" are required." />
        </TextBlock>

        <TextBlock Text="Room details" Style="{StaticResource SectionTitle}" />
        <TextBlock Style="{StaticResource FieldLabel}">
          <Run Text="Room name" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" />
        </TextBlock>
        <TextBox x:Name="RoomNameField" Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}" MaxLength="22"
                 automation:AutomationProperties.Name="Room name" automation:AutomationProperties.IsRequiredForForm="True"
                 Margin="0,0,0,20" />

        <TextBlock Style="{StaticResource FieldLabel}">
          <Run Text="Trainer display name" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" />
        </TextBlock>
        <TextBox Text="{Binding TrainerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"
                 automation:AutomationProperties.Name="Trainer display name" automation:AutomationProperties.IsRequiredForForm="True"
                 Margin="0,0,0,20" />

        <Grid Margin="0,0,0,32">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Game" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" /></TextBlock>
            <ComboBox ItemsSource="{Binding GameVersions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding GameVersion}" automation:AutomationProperties.Name="Game"
                      automation:AutomationProperties.IsRequiredForForm="True" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Language" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" /></TextBlock>
            <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Language}" automation:AutomationProperties.Name="Language"
                      automation:AutomationProperties.IsRequiredForForm="True" />
          </StackPanel>
        </Grid>

        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,32" />
        <TextBlock Text="How the room appears" Style="{StaticResource SectionTitle}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <RadioButton Content="Private room" GroupName="RoomVisibility" IsChecked="{Binding IsPrivateRoom, Mode=TwoWay}" Margin="0,0,28,0" />
          <RadioButton Content="Public room — Preview" GroupName="RoomVisibility" IsChecked="{Binding IsPublicPreview, Mode=TwoWay}" />
        </StackPanel>
        <Border Style="{StaticResource InlineNotice}" Visibility="{Binding IsPublicPreview, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Text="Demo Preview — this creates a local sample preview. No room is published and no trainer is contacted." />
        </Border>
        <TextBlock Text="For private rooms, these optional details are added only to copied invitation text. They are not published."
                   Style="{StaticResource SecondaryText}" Margin="0,0,0,18" />

        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Offering (optional)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Offering, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Looking for (optional)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Wanted, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" />
          </StackPanel>
        </Grid>
        <TextBlock Text="Short note (optional)" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="120"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76" MaxHeight="160"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />

        <Border Style="{StaticResource ErrorNotice}" Margin="0,18,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}"
                automation:AutomationProperties.LiveSetting="Assertive">
          <TextBlock Text="{Binding ErrorMessage}" />
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,20">
      <Button Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="190">
        <StackPanel Orientation="Horizontal">
          <ProgressBar IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0"
                       Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
          <TextBlock Text="{Binding SubmitText}" />
        </StackPanel>
      </Button>
    </Border>
  </Grid>
</UserControl>
