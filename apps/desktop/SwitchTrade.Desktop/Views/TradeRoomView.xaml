<UserControl x:Class="SwitchTrade.Desktop.Views.TradeRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:components="clr-namespace:SwitchTrade.Desktop.Views.Components"
             Loaded="ViewLoaded" SizeChanged="ViewSizeChanged">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,6,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="ACTIVE SESSION" Style="{StaticResource KickerText}" Margin="0,0,0,7" />
        <TextBlock Text="{Binding RoomName}" Style="{StaticResource ScreenTitle}"
                   automation:AutomationProperties.HeadingLevel="Level1" />
        <WrapPanel>
          <TextBlock Text="{Binding VisibilityLabel}" Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBlock Text="  ·  " Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBlock Text="{Binding ConnectionStatus}" Foreground="{DynamicResource SecondaryTextBrush}"
                     automation:AutomationProperties.LiveSetting="Polite" />
        </WrapPanel>
      </StackPanel>
      <Button Grid.Column="2" Content="{Binding MembershipActionText}" Command="{Binding LeaveCommand}"
              Style="{StaticResource DangerButton}" HorizontalAlignment="Right" VerticalAlignment="Top" />
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
      <components:LinklineControl YouSummary="{Binding YouSummary}" PartnerSummary="{Binding PartnerSummary}"
                                  StatusText="{Binding LinklineState}" />
    </Border>

    <Grid Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,18">
          <Border Style="{StaticResource ErrorNotice}"
                  Visibility="{Binding HasRecovery, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
              <TextBlock Text="Connection needs attention" FontWeight="SemiBold" Margin="0,0,0,4" />
              <TextBlock Text="{Binding RecoveryMessage}" />
              <Button Content="Repair adapter" Command="{Binding RepairAdapterCommand}"
                      Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                      Visibility="{Binding HasAdapterRepair, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SuccessNotice}"
                  Visibility="{Binding HasTradeCommit, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
              <TextBlock Text="Trade verified" FontWeight="SemiBold" Margin="0,0,0,4" />
              <TextBlock Text="{Binding TradeCommitStatus}" />
            </StackPanel>
          </Border>

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="7*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="5*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SurfaceCard}">
              <StackPanel>
                <TextBlock Text="{Binding StageHeading}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding InstructionDetails}" FontSize="15" LineHeight="23" />
                <TextBlock Text="{Binding LimitationNotice}" Style="{StaticResource SecondaryText}" Margin="0,14,0,0" />
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource SurfaceSubtleBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18"
                    Visibility="{Binding HasRoomCode, Converter={StaticResource BooleanToVisibility}}">
              <StackPanel>
                <TextBlock Text="ROOM CODE" Style="{StaticResource KickerText}" />
                <TextBlock Text="{Binding RoomCode}" Style="{StaticResource CodeText}"
                           FontSize="25" Margin="0,5,0,12" />
                <WrapPanel>
                  <Button Content="Copy code" Command="{Binding CopyCodeCommand}"
                          Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                  <Button Content="Copy invitation" Command="{Binding CopyInvitationCommand}"
                          Style="{StaticResource TextButton}" Margin="0,0,0,8" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </Grid>

          <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,14"
                  BorderBrush="{DynamicResource ActionGreenBrush}"
                  Visibility="{Binding HasSelectedPokemon, Converter={StaticResource BooleanToVisibility}}"
                  automation:AutomationProperties.LiveSetting="Polite">
            <StackPanel>
              <Grid>
                <StackPanel>
                  <TextBlock Text="{Binding SelectedPokemon.Nickname}" Style="{StaticResource SectionTitle}" />
                  <TextBlock Foreground="{DynamicResource SecondaryTextBrush}">
                    <Run Text="{Binding SelectedPokemon.Species, Mode=OneWay}" /><Run Text=" · Checksum-verified data" />
                  </TextBlock>
                </StackPanel>
                <Button Content="Close details" Command="{Binding ClearPokemonCommand}"
                        Style="{StaticResource TextButton}" HorizontalAlignment="Right" VerticalAlignment="Top" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding SelectedPokemon.Nature, StringFormat=Nature: {0}}" />
                  <TextBlock Text="{Binding SelectedPokemon.HeldItemText, StringFormat=Held item: {0}}" />
                  <TextBlock Text="{Binding SelectedPokemon.StatsText, StringFormat=Stats: {0}}" Margin="0,8,0,0" />
                  <TextBlock Text="{Binding SelectedPokemon.IvsText, StringFormat=IVs: {0}}" />
                  <TextBlock Text="{Binding SelectedPokemon.EvsText, StringFormat=EVs: {0}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                  <TextBlock Text="{Binding SelectedPokemon.MovesText, StringFormat=Moves: {0}}" />
                  <TextBlock Text="{Binding SelectedPokemon.TrainerText, StringFormat=Trainer: {0}}" Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Grid x:Name="LivePartyLayout"
                Visibility="{Binding HasPartyData, Converter={StaticResource BooleanToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="LiveYouPartyColumn" />
              <ColumnDefinition x:Name="LivePartyGutterColumn" Width="18" />
              <ColumnDefinition x:Name="LivePartnerPartyColumn" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition x:Name="LivePartyRowGutter" Height="0" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <components:PartyGrid x:Name="LiveYouPartyGrid" Heading="You" Slots="{Binding YouParty.Slots}"
                                  SelectCommand="{Binding SelectPokemonCommand}"
                                  AccentBrush="{DynamicResource YouTintBrush}" />
            <components:PartyGrid x:Name="LivePartnerPartyGrid" Grid.Column="2" Heading="Partner"
                                  Slots="{Binding PartnerParty.Slots}"
                                  SelectCommand="{Binding SelectPokemonCommand}"
                                  AccentBrush="{DynamicResource TealTintBrush}" />
          </Grid>

          <Border Style="{StaticResource SurfaceCard}"
                  Visibility="{Binding HasPartyData, Converter={StaticResource InverseBooleanToVisibility}}">
            <TextBlock Text="Party details appear only after the passive decoder has a complete, checksum-valid snapshot. Trading does not depend on this display."
                       Style="{StaticResource SecondaryText}" />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="1" Style="{StaticResource StickyActionBar}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding ConnectionStatus}" Style="{StaticResource SecondaryText}"
                     Margin="0,0,18,0"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                      Visibility="{Binding ShowRoleChoices, Converter={StaticResource BooleanToVisibility}}">
            <Button Content="I am the Group Leader" Command="{Binding GroupLeaderCommand}"
                    Style="{StaticResource SecondaryButton}" MinWidth="210" Margin="0,0,10,0" />
            <Button Content="I am Joining" Command="{Binding JoiningCommand}"
                    Style="{StaticResource SecondaryButton}" MinWidth="210" />
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding ConnectionCommand}" Style="{StaticResource PrimaryButton}"
                  HorizontalAlignment="Right" MinWidth="190"
                  Visibility="{Binding ShowEndConnection, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <ProgressBar IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0"
                           Visibility="{Binding IsConnectionPending, Converter={StaticResource BooleanToVisibility}}" />
              <TextBlock Text="End connection" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
