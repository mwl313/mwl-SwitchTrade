<UserControl x:Class="SwitchTrade.Desktop.Views.TradeRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:components="clr-namespace:SwitchTrade.Desktop.Views.Components"
             Loaded="ViewLoaded" SizeChanged="ViewSizeChanged">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,6,0,14">
      <TextBlock Text="{Binding RoomName}" Style="{StaticResource ScreenTitle}"
                 automation:AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Text="{Binding VisibilityLabel}" Foreground="{DynamicResource SecondaryTextBrush}" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
      <components:LinklineControl YouSummary="{Binding YouSummary}" PartnerSummary="{Binding PartnerSummary}"
                                  YouPresence="{Binding YouPresenceText}"
                                  PartnerPresence="{Binding PartnerPresenceText}"
                                  PartnerIsOnline="{Binding PartnerOnline}"
                                  StatusText="{Binding LinklineState}" />
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,18">
        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,14"
                automation:AutomationProperties.LiveSetting="Polite">
          <StackPanel>
            <TextBlock Text="Status" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding ConnectionStatus}" FontSize="16" TextWrapping="Wrap" />

            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding HasRecovery, Converter={StaticResource BooleanToVisibility}}">
              <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,14" />
              <TextBlock Text="Connection needs attention" Foreground="{DynamicResource DangerBrush}"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding RecoveryMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
              <TextBlock Text="{Binding RecoveryCode}" FontFamily="{StaticResource MonoFontFamily}"
                         Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,5,0,0" />
              <Button Content="{Binding AdapterRecoveryLabel}" Command="{Binding RepairAdapterCommand}"
                      Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                      Visibility="{Binding HasAdapterRepair, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>

            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding HasUserCheckpoint, Converter={StaticResource BooleanToVisibility}}">
              <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,14" />
              <TextBlock Text="Switch action required" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CheckpointInstructions}" TextWrapping="Wrap" Margin="0,4,0,0" />
              <Button Content="Continue" Command="{Binding ContinueCommand}"
                      Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
            </StackPanel>

            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding ShowRoleChoices, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock Text="What will your Switch do?" FontWeight="SemiBold" Margin="0,0,0,10" />
              <WrapPanel>
                <Button Content="Group Leader" Command="{Binding GroupLeaderCommand}"
                        Style="{StaticResource SecondaryButton}" MinWidth="180" Margin="0,0,10,8" />
                <Button Content="Joining" Command="{Binding JoiningCommand}"
                        Style="{StaticResource SecondaryButton}" MinWidth="180" Margin="0,0,0,8" />
              </WrapPanel>
            </StackPanel>

            <WrapPanel Margin="0,16,0,0">
              <Button Command="{Binding ConnectionCommand}" Style="{StaticResource PrimaryButton}"
                      MinWidth="170" Margin="0,0,10,8"
                      Visibility="{Binding ShowEndConnection, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Orientation="Horizontal">
                  <ProgressBar IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0"
                               Visibility="{Binding IsConnectionPending, Converter={StaticResource BooleanToVisibility}}" />
                  <TextBlock Text="{Binding ConnectionActionText}" />
                </StackPanel>
              </Button>
              <Button Content="{Binding MembershipActionText}" Command="{Binding LeaveCommand}"
                      Style="{StaticResource DangerButton}" Margin="0,0,0,8" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,14"
                Visibility="{Binding HasRoomCode, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel>
            <TextBlock Text="ROOM CODE" Style="{StaticResource KickerText}" />
            <TextBlock Text="{Binding RoomCode}" Style="{StaticResource CodeText}"
                       FontSize="25" Margin="0,5,0,12" />
            <WrapPanel>
              <Button Content="Copy code" Command="{Binding CopyCodeCommand}"
                      Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
              <Button Content="Copy invitation" Command="{Binding CopyInvitationCommand}"
                      Style="{StaticResource TextButton}" Margin="0,0,0,8" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SuccessNotice}" Margin="0,0,0,14"
                Visibility="{Binding HasTradeCommit, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel>
            <TextBlock Text="Trade verified" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="{Binding TradeCommitStatus}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,14"
                BorderBrush="{DynamicResource ActionGreenBrush}"
                Visibility="{Binding HasSelectedPokemon, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel>
            <Grid>
              <StackPanel>
                <TextBlock Text="{Binding SelectedPokemon.Nickname}" Style="{StaticResource SectionTitle}" />
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}">
                  <Run Text="{Binding SelectedPokemon.Species, Mode=OneWay}" /><Run Text=" · Verified" />
                </TextBlock>
              </StackPanel>
              <Button Content="Close details" Command="{Binding ClearPokemonCommand}"
                      Style="{StaticResource TextButton}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding SelectedPokemon.Nature, StringFormat=Nature: {0}}" />
                <TextBlock Text="{Binding SelectedPokemon.HeldItemText, StringFormat=Held item: {0}}" />
                <TextBlock Text="{Binding SelectedPokemon.StatsText, StringFormat=Stats: {0}}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding SelectedPokemon.IvsText, StringFormat=IVs: {0}}" />
                <TextBlock Text="{Binding SelectedPokemon.EvsText, StringFormat=EVs: {0}}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="18,0,0,0">
                <TextBlock Text="{Binding SelectedPokemon.MovesText, StringFormat=Moves: {0}}" />
                <TextBlock Text="{Binding SelectedPokemon.TrainerText, StringFormat=Trainer: {0}}" Margin="0,8,0,0" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Grid x:Name="LivePartyLayout"
              Visibility="{Binding HasPartyData, Converter={StaticResource BooleanToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LiveYouPartyColumn" />
            <ColumnDefinition x:Name="LivePartyGutterColumn" Width="18" />
            <ColumnDefinition x:Name="LivePartnerPartyColumn" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition x:Name="LivePartyRowGutter" Height="0" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <components:PartyGrid x:Name="LiveYouPartyGrid" Heading="You" Slots="{Binding YouParty.Slots}"
                                SelectCommand="{Binding SelectPokemonCommand}"
                                AccentBrush="{DynamicResource YouTintBrush}" />
          <components:PartyGrid x:Name="LivePartnerPartyGrid" Grid.Column="2" Heading="Partner"
                                Slots="{Binding PartnerParty.Slots}"
                                SelectCommand="{Binding SelectPokemonCommand}"
                                AccentBrush="{DynamicResource TealTintBrush}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
