<UserControl x:Class="SwitchTrade.Desktop.Views.TradeRoomView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:components="clr-namespace:SwitchTrade.Desktop.Views.Components"
             Loaded="ViewLoaded" SizeChanged="ViewSizeChanged">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding RoomName}" Style="{StaticResource ScreenTitle}"
                     automation:AutomationProperties.HeadingLevel="Level1" />
          <Border Style="{StaticResource DemoBadge}" Margin="12,2,0,0" VerticalAlignment="Top"
                  Visibility="{Binding IsDemoPreview, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="Demo Preview" Foreground="{DynamicResource LinkBlueBrush}" FontWeight="SemiBold" FontSize="12" />
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding VisibilityLabel}" Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBlock Text="  ·  " Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBlock Text="{Binding ConnectionStatus}" Foreground="{DynamicResource SecondaryTextBrush}"
                     automation:AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </StackPanel>
      <Button Content="{Binding MembershipActionText}" Command="{Binding LeaveCommand}" Style="{StaticResource DangerButton}"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Visibility="{Binding IsRealRoom, Converter={StaticResource BooleanToVisibility}}" />
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="0,0,0,18">
      <components:LinklineControl YouSummary="{Binding YouSummary}" PartnerSummary="{Binding PartnerSummary}"
                                  StatusText="{Binding LinklineState}" />
    </Border>

    <Grid Grid.Row="2">
      <Grid Visibility="{Binding IsRealRoom, Converter={StaticResource BooleanToVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,12,20">
            <Border Style="{StaticResource InlineNotice}"><TextBlock Text="{Binding LimitationNotice}" /></Border>
            <Border Style="{StaticResource ErrorNotice}"
                    Visibility="{Binding HasRecovery, Converter={StaticResource BooleanToVisibility}}">
              <StackPanel>
                <TextBlock Text="Connection needs attention" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="{Binding RecoveryMessage}" />
                <Button Content="Repair adapter" Command="{Binding RepairAdapterCommand}"
                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Visibility="{Binding HasAdapterRepair, Converter={StaticResource BooleanToVisibility}}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SuccessNotice}"
                    Visibility="{Binding HasTradeCommit, Converter={StaticResource BooleanToVisibility}}">
              <StackPanel>
                <TextBlock Text="Trade verified" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="{Binding TradeCommitStatus}" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding StageHeading}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding InstructionDetails}" FontSize="16" LineHeight="24" Margin="0,0,0,20" />
            <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="8" Padding="18"
                    Visibility="{Binding HasRoomCode, Converter={StaticResource BooleanToVisibility}}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Room code" Style="{StaticResource SecondaryText}" />
                  <TextBlock Text="{Binding RoomCode}" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" FontSize="22" />
                </StackPanel>
                <Button Grid.Column="1" Content="Copy code" Command="{Binding CopyCodeCommand}" Style="{StaticResource TextButton}" />
                <Button Grid.Column="3" Content="Copy invitation" Command="{Binding CopyInvitationCommand}" Style="{StaticResource TextButton}" />
              </Grid>
            </Border>
            <TextBlock Text="Party details will appear after the passive live decoder is connected. Trading does not depend on party display."
                       Style="{StaticResource SecondaryText}" Margin="0,18,0,12" />
            <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,18" BorderBrush="{DynamicResource LinkBlueBrush}"
                    Visibility="{Binding HasSelectedPokemon, Converter={StaticResource BooleanToVisibility}}"
                    automation:AutomationProperties.LiveSetting="Polite">
              <StackPanel>
                <Grid>
                  <StackPanel>
                    <TextBlock Text="{Binding SelectedPokemon.Nickname}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}">
                      <Run Text="{Binding SelectedPokemon.Species}" /><Run Text=" · Verified live data" />
                    </TextBlock>
                  </StackPanel>
                  <Button Content="Close details" Command="{Binding ClearPokemonCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16" />
                <TextBlock Text="{Binding SelectedPokemon.Nature, StringFormat=Nature: {0}}" />
                <TextBlock Text="{Binding SelectedPokemon.HeldItemText, StringFormat=Held item: {0}}" />
                <TextBlock Text="{Binding SelectedPokemon.StatsText, StringFormat=Party stats: {0}}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding SelectedPokemon.IvsText, StringFormat=IVs: {0}}" />
                <TextBlock Text="{Binding SelectedPokemon.EvsText, StringFormat=EVs: {0}}" />
                <TextBlock Text="{Binding SelectedPokemon.MovesText, StringFormat=Moves: {0}}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding SelectedPokemon.TrainerText, StringFormat=Trainer: {0}}" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Grid x:Name="LivePartyLayout"
                  Visibility="{Binding HasPartyData, Converter={StaticResource BooleanToVisibility}}">
              <Grid.ColumnDefinitions><ColumnDefinition x:Name="LiveYouPartyColumn" /><ColumnDefinition x:Name="LivePartyGutterColumn" Width="18" /><ColumnDefinition x:Name="LivePartnerPartyColumn" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition x:Name="LivePartyRowGutter" Height="0" /><RowDefinition /></Grid.RowDefinitions>
              <components:PartyGrid x:Name="LiveYouPartyGrid" Heading="You" Slots="{Binding YouParty.Slots}"
                                    SelectCommand="{Binding SelectPokemonCommand}" AccentBrush="{DynamicResource BlueTintBrush}" />
              <components:PartyGrid x:Name="LivePartnerPartyGrid" Grid.Column="2" Heading="Partner" Slots="{Binding PartnerParty.Slots}"
                                    SelectCommand="{Binding SelectPokemonCommand}" AccentBrush="{DynamicResource TealTintBrush}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource StickyActionBar}">
          <Button Command="{Binding ConnectionCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" MinWidth="190">
            <StackPanel Orientation="Horizontal">
              <ProgressBar IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0"
                           Visibility="{Binding IsConnectionPending, Converter={StaticResource BooleanToVisibility}}" />
              <TextBlock Text="{Binding ConnectionActionText}" />
            </StackPanel>
          </Button>
        </Border>
      </Grid>

      <ScrollViewer Visibility="{Binding IsDemoPreview, Converter={StaticResource BooleanToVisibility}}"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,32">
          <Border Style="{StaticResource InlineNotice}"><TextBlock Text="{Binding InstructionDetails}" /></Border>
          <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,18" BorderBrush="{DynamicResource LinkBlueBrush}"
                  Visibility="{Binding HasSelectedPokemon, Converter={StaticResource BooleanToVisibility}}"
                  automation:AutomationProperties.LiveSetting="Polite">
            <StackPanel>
              <Grid>
                <StackPanel>
                  <TextBlock Text="{Binding SelectedPokemon.Nickname}" Style="{StaticResource SectionTitle}" />
                  <TextBlock Foreground="{DynamicResource SecondaryTextBrush}">
                    <Run Text="{Binding SelectedPokemon.Species}" /><Run Text=" · Sample preview" />
                  </TextBlock>
                </StackPanel>
                <Button Content="Close details" Command="{Binding ClearPokemonCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Right" VerticalAlignment="Top" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16" />
              <TextBlock Text="{Binding SelectedPokemon.Nature, StringFormat=Nature: {0}}" />
              <TextBlock Text="{Binding SelectedPokemon.HeldItemText, StringFormat=Held item: {0}}" />
              <TextBlock Text="{Binding SelectedPokemon.StatsText, StringFormat=Party stats: {0}}" Margin="0,8,0,0" />
              <TextBlock Text="{Binding SelectedPokemon.IvsText, StringFormat=IVs: {0}}" />
              <TextBlock Text="{Binding SelectedPokemon.EvsText, StringFormat=EVs: {0}}" />
              <TextBlock Text="{Binding SelectedPokemon.MovesText, StringFormat=Moves: {0}}" Margin="0,8,0,0" />
              <TextBlock Text="{Binding SelectedPokemon.TrainerText, StringFormat=Trainer: {0}}" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <Grid x:Name="PartyLayout">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="YouPartyColumn" /><ColumnDefinition x:Name="PartyGutterColumn" Width="18" /><ColumnDefinition x:Name="PartnerPartyColumn" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition /><RowDefinition x:Name="PartyRowGutter" Height="0" /><RowDefinition /></Grid.RowDefinitions>
            <components:PartyGrid x:Name="YouPartyGrid" Heading="You" Slots="{Binding YouParty.Slots}"
                                  SelectCommand="{Binding SelectPokemonCommand}" AccentBrush="{DynamicResource BlueTintBrush}" />
            <components:PartyGrid x:Name="PartnerPartyGrid" Grid.Column="2" Heading="Partner" Slots="{Binding PartnerParty.Slots}"
                                  SelectCommand="{Binding SelectPokemonCommand}" AccentBrush="{DynamicResource TealTintBrush}" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
